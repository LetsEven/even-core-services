# Ver README.md. Todas son opcionales en desarrollo. En produccion (NODE_ENV=production) son obligatorias
# CREW_AUTH_PRIVATE_KEY y el origen CORS.
PORT=8787
DATA_DIR=./data
CREW_AUTH_ORIGINS=http://localhost:5173
CREW_AUTH_ISSUER=crew-auth
# PEM PKCS8 EdDSA (Ed25519). Fuera de produccion, si falta se genera y persiste en DATA_DIR con permisos 600;
# con NODE_ENV=production es obligatoria y no se autogenera.
# CREW_AUTH_PRIVATE_KEY=
# Secreto (32+ caracteres) para el HMAC del PIN. Obligatorio en produccion; en desarrollo se usa uno fijo si falta.
# CREW_AUTH_PIN_PEPPER=
