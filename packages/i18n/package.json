{
  "name": "@even/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Textos compartidos de las apps de comensal (es/en) y helper para combinarlos con los de cada app.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./messages/es.json": "./src/messages/es.json",
    "./messages/en.json": "./src/messages/en.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@even/eslint-config": "*",
    "@even/tsconfig": "*",
    "eslint": "^9",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
